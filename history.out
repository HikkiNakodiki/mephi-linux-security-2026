    1  whoami
    2  grep user1 /etc/passwd
    3  grep students /etc/group
    4  id user1
    5  getent passwd 1234
    6  chage -M 90 user1
    7  chage -l user1
    8  grep user1 /etc/shadow
    9  find / -perm -4000 0type f 2>/dev/null | tee ~/suid_files.out
   10  ping 8.8.8.8
   11  sudo dnf install openssh-server -y
   12  sudo systemctl start sshd
   13  sudo systemctl enable sshd
   14  systemctl status sshdо
   15  systemctl status sshd
   16  sudo firewall-cmd --reload
   17  sudo firewall-cmd --permanent --add-service=ssh
   18  sudo firewall-cmd --reload
   19  ip a
   20  histori
   21  history
   22  mkdir -p /home/user1/artifacts
   23  cp /root/history.out /root/stat.out /root/getcap.out    /root/suid_files.out /root/euid0_procs.out    /home/user1/artifacts/
   24  chown -R user1:students /home/user1/artifacts
   25  ls -l /home/user1/artifacts/
   26  cp /etc/passwd  /home/user1/artifacts/passwd.out
   27  cp /etc/shadow  /home/user1/artifacts/shadow.out
